# Copy to .env for local use. NEVER commit real values. On Render, set these in Environment.
PORT=3000
ADMIN_KEY=put-a-long-random-secret-here-at-least-16-characters
SESSION_SECRET=put-another-long-random-secret-here-at-least-32-characters
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.REGION.firebasedatabase.app/
FIREBASE_SERVICE_ACCOUNT_BASE64=base64-of-your-service-account-json
# Optional: call records older than this many days are deleted automatically (default 365)
RETENTION_DAYS=365
